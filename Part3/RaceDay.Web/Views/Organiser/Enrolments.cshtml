@model List<EnrolmentVm>
    @{
    ViewData["Title"] = "Enrolments";
    var ev = (EventVm)ViewBag.Event;
    }
    <a asp-action="Events" class="btn btn-link ps-0">&larr; My events</a>
    <h2 class="mb-3">Enrolments: @ev.Name</h2>
    <table class="table bg-white align-middle">
        <thead><tr><th>Participant</th><th>Category</th><th>Enrolled on</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var e in Model)
    {
            <tr>
                <td>@e.ParticipantName</td>
                <td>@e.CategoryName</td>
                <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                <td><span class="status-badge status-@e.Status.ToLower()">@e.Status</span></td>
                <td class="text-end text-nowrap">
                    @foreach (var st in new[] { "Confirmed", "Pending", "Cancelled" }.Where(x => x != e.Status))
                {
                    <form asp-action="SetStatus" method="post" class="d-inline">
                        <input type="hidden" name="enrolmentId" value="@e.EnrolmentId" />
                        <input type="hidden" name="eventId" value="@ev.EventId" />
                        <input type="hidden" name="status" value="@st" />
                        <button class="btn btn-outline-primary btn-sm">Mark @st</button>
                    </form>
                }
                </td>
            </tr>
    }
        </tbody>
    </table>
    @if (!Model.Any()) { <p class="text-muted">Nobody has enrolled yet.</p> }
