@model List<EventVm>
    @{ ViewData["Title"] = "Events"; }

    <div class="rd-hero text-center">
        <h1>Find your next finish line</h1>
        <p class="lead mb-0">Road running, walking and cycling events across South Africa.</p>
    </div>

    @if (ViewBag.Offline == true)
{
    <div class="alert alert-warning">We can't load events right now. Please try again shortly.</div>
}

    <form method="get" class="card p-3 mb-4">
        <div class="row g-2">
            <div class="col-md-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search name or location" /></div>
            <div class="col-md-3">
                <select name="type" class="form-select">
                    <option value="">All types</option>
                    @foreach (var t in new[] { "Run", "Walk", "Cycle" })
                {
                    <option value="@t" selected="@((string?)ViewBag.Type == t)">@t</option>
                }
                </select>
            </div>
            <div class="col-md-3"><input type="date" name="from" value="@ViewBag.From" class="form-control" /></div>
            <div class="col-md-2"><button class="btn btn-primary w-100">Filter</button></div>
        </div>
    </form>

    <div class="row g-4">
        @foreach (var e in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(e.BannerUrl)) { <img class="event-banner" src="@e.BannerUrl" alt="@e.Name" /> }
                else { <div class="event-banner"></div> }
                <div class="card-body">
                    <span class="badge bg-dark mb-2">@e.EventType</span>
                    <h5>@e.Name</h5>
                    <p class="text-muted mb-1">@e.EventDate.ToString("dd MMM yyyy, HH:mm")</p>
                    <p class="mb-1">@e.Location</p>
                    @if (e.DistanceKm.HasValue) { <p class="mb-0">@e.DistanceKm km</p> }
                </div>
                <div class="card-footer bg-white border-0">
                    <a class="btn btn-primary w-100" asp-action="Details" asp-route-id="@e.EventId">View event</a>
                </div>
            </div>
        </div>
    }
    </div>
    @if (!Model.Any() && ViewBag.Offline != true)
{
    <p class="text-muted">No upcoming events match your search.</p>
}
